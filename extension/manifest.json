{
  "manifest_version": 3,
  "name": "Friberg Assistant — Live DOM Assist",
  "version": "0.9.9",
  "description": "弗一把可见反馈助手：低延迟首猜、答案优先策略、事件驱动提交、多人托管与单人连续循环。",
  "permissions": [
    "storage",
    "scripting",
    "notifications",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://shnlfriberg.online/multi*",
    "https://shnlfriberg.online/single*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shnlfriberg.online/multi*",
        "https://shnlfriberg.online/single*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "css": [
        "overlay.css",
        "live-qol.css",
        "autoplay.css"
      ],
      "js": [
        "solver.js",
        "automation-core.js",
        "speed-strategy.js",
        "enable-race-strategy.js",
        "live-dom-adapter.js",
        "feedback-parser-patch.js",
        "overlay.js",
        "live-qol.js",
        "content-script.js",
        "autoplay.js",
        "autoplay-hotfix.js",
        "instant-next.js",
        "speed-telemetry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "solver-worker.js",
        "solver.js",
        "automation-core.js",
        "live-dom-adapter.js",
        "feedback-parser-patch.js",
        "data/game-players-646.json"
      ],
      "matches": [
        "<all_urls>",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Friberg Assistant"
  }
}
