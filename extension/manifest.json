{
  "manifest_version": 3,
  "name": "Friberg Assistant — Live DOM Assist",
  "version": "0.9.5",
  "description": "弗一把可见反馈助手：严格求解、BO3换局恢复、匹配通知、refrezh首猜及用户触发的填入与提交。",
  "permissions": ["storage", "scripting", "notifications", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://shnlfriberg.online/multi*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shnlfriberg.online/multi*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "css": ["overlay.css"],
      "js": ["solver.js", "automation-core.js", "live-dom-adapter.js", "feedback-parser-patch.js", "overlay.js", "live-qol.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js", "solver-worker.js", "solver.js", "automation-core.js", "live-dom-adapter.js", "feedback-parser-patch.js", "data/game-players-646.json"],
      "matches": [
        "<all_urls>",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Friberg Assistant" }
}
