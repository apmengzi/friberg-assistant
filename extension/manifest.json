{
  "manifest_version": 3,
  "name": "Friberg Race Lite",
  "version": "1.0.0",
  "description": "弗一把多人纯竞速版：固定 refrezh 首猜、可见反馈精确候选、提前填入并走原网页提交路径。",
  "host_permissions": [
    "https://shnlfriberg.online/multi*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shnlfriberg.online/multi*"
      ],
      "js": [
        "solver.js",
        "live-dom-adapter.js",
        "feedback-parser-patch.js",
        "race-policy.js",
        "race-controller.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/game-players-646.json"
      ],
      "matches": [
        "https://shnlfriberg.online/*"
      ]
    }
  ],
  "action": {
    "default_title": "Friberg Race Lite"
  }
}
