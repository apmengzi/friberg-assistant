{
  "manifest_version": 3,
  "name": "Friberg Ultimate Assistant",
  "version": "1.1.0",
  "description": "弗一把完整助手：只读推荐、单人本局自动、单人连续循环、多人稳健托管与多人竞速托管。",
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://shnlfriberg.online/single*",
    "https://shnlfriberg.online/multi*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shnlfriberg.online/single*",
        "https://shnlfriberg.online/multi*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "css": [
        "ultimate-ui.css"
      ],
      "js": [
        "solver.js",
        "automation-core.js",
        "ultimate-policy.js",
        "ultimate-dom.js",
        "ultimate-ui.js",
        "ultimate-controller.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/game-players-646.json"
      ],
      "matches": [
        "https://shnlfriberg.online/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Friberg Ultimate Assistant"
  }
}
