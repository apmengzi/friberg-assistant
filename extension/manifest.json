{
  "manifest_version": 3,
  "name": "Friberg Race Lite",
  "version": "1.0.1",
  "description": "弗一把多人纯竞速版：固定 refrezh 首猜、官方表单直提、可见反馈竞速求解与题库漂移容错。",
  "host_permissions": [
    "https://shnlfriberg.online/multi*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shnlfriberg.online/multi*"
      ],
      "js": [
        "solver.js",
        "race-policy.js",
        "race-controller.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/game-players-646.json"
      ],
      "matches": [
        "https://shnlfriberg.online/*"
      ]
    }
  ],
  "action": {
    "default_title": "Friberg Race Lite"
  }
}
